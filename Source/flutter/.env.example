API_BASE_URL=http://localhost:5005/api

# Android (máy ảo hoặc điện thoại cắm USB): chạy "adb reverse tcp:5005 tcp:5005" để localhost trỏ về máy tính.
# Không bắt buộc: tên máy thay cho localhost trên Android (VD 10.0.2.2 cho máy ảo); API phải chấp nhận tên đó (AllowedHosts).
API_ANDROID_HOST=

# API nội bộ (ApplicationMode=Internal) cho phần bản ký giấy. Để trống thì dùng API_BASE_URL.
# Điện thoại cắm USB: chạy "adb reverse tcp:5205 tcp:5205" để localhost trỏ về máy tính.
API_INTERNAL_BASE_URL=http://localhost:5205
